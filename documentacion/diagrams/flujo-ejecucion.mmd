%%{init: {'flowchart': {'nodeSpacing': 18, 'rankSpacing': 26, 'padding': 6, 'curve': 'basis'}, 'themeVariables': {'fontSize': '14px'}}}%%
flowchart TD
    START(["Documento en<br/>S3 raw/"]):::storage --> SFNPRE["Step Functions:<br/>Classification + Processing"]:::ml
    SFNPRE --> H["Enrichment Lambda<br/>handler.py"]:::compute
    H --> DEC{"¿Field-centric<br/>o pipeline:<br/>expediente?"}:::decision

    DEC -->|"SÍ"| CAMINOA
    DEC -->|"NO"| CAMINOB

    subgraph CAMINOA["Camino A — Expediente (PEDIMENTO_ADUANAL)"]
        direction TB
        P1["1. pdf_pages<br/>texto + Textract"]:::ml
        P2["2. segmenter<br/>Bedrock"]:::ml
        P3["3. text_extractor<br/>Bedrock, paralelo"]:::ml
        P4["4-5. normalize + engine<br/>reglas del catálogo"]:::compute
        P6["6. reglas<br/>cross-documento"]:::compute
        P1 --> P2 --> P3 --> P4 --> P6
    end

    subgraph CAMINOB["Camino B — Estándar (catalogs/save/)"]
        direction TB
        S1["1. reutiliza extracción<br/>Bedrock"]:::ml
        S2["2. validator_module"]:::compute
        S3["3. fallback<br/>Textract"]:::ml
        S4["4. custom_validator"]:::compute
        S1 --> S2 --> S3 --> S4
    end

    CAMINOA --> ASM
    CAMINOB --> ASM["Ensamblado + tracking"]:::compute

    ASM --> S3R[("S3 results/")]:::storage
    ASM --> DDB[("DynamoDB<br/>compacto")]:::database
    S3R --> EB["EventBridge"]:::integration
    DDB --> EB

    classDef compute fill:#ED7100,stroke:#9D4E00,color:#fff,font-weight:bold
    classDef storage fill:#7AA116,stroke:#4B6B0B,color:#fff,font-weight:bold
    classDef database fill:#3B48CC,stroke:#232B85,color:#fff,font-weight:bold
    classDef integration fill:#E7157B,stroke:#99034F,color:#fff,font-weight:bold
    classDef ml fill:#01A88D,stroke:#016657,color:#fff,font-weight:bold
    classDef decision fill:#F2F2F2,stroke:#666,color:#111

    style CAMINOA fill:transparent,stroke:#ED7100,stroke-width:1px,stroke-dasharray: 3 3,color:#333
    style CAMINOB fill:transparent,stroke:#999,stroke-width:1px,stroke-dasharray: 3 3,color:#333
