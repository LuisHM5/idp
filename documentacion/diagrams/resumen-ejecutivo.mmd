%%{init: {'flowchart': {'nodeSpacing': 45, 'rankSpacing': 80, 'padding': 14, 'curve': 'basis'}, 'themeVariables': {'fontSize': '18px', 'fontFamily': 'Segoe UI, Helvetica, Arial, sans-serif'}}}%%
flowchart LR
    A(["📄 Llega un<br/>documento"]):::entrada
    B["🤖 El sistema lo lee<br/>y entiende solo<br/><span style='font-size:13px'>(sin captura manual)</span>"]:::proceso
    C{"🔎 ¿Está correcto<br/>y completo?"}:::decision
    D["✅ Validado,<br/>listo para usarse"]:::exito
    E["⚠️ Se separa a revisión,<br/>con el motivo señalado"]:::alerta
    F(["🗂️ Disponible para<br/>quien lo necesite"]):::fin

    A --> B --> C
    C -->|"Sí"| D
    C -->|"No"| E
    D --> F
    E --> F

    classDef entrada fill:#4A90D9,stroke:#2C5C8F,stroke-width:2px,color:#fff,font-weight:600
    classDef proceso fill:#7B5FC7,stroke:#4E3A85,stroke-width:2px,color:#fff,font-weight:600
    classDef decision fill:#FDF6E3,stroke:#C9A227,stroke-width:2px,color:#5c4a00,font-weight:600
    classDef exito fill:#3FA34D,stroke:#256B31,stroke-width:2px,color:#fff,font-weight:600
    classDef alerta fill:#E8A33D,stroke:#A6701F,stroke-width:2px,color:#fff,font-weight:600
    classDef fin fill:#2CA6A4,stroke:#1B6D6C,stroke-width:2px,color:#fff,font-weight:600

    linkStyle default stroke:#999,stroke-width:2.5px
