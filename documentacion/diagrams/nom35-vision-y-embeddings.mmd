%%{init: {'flowchart': {'nodeSpacing': 22, 'rankSpacing': 30, 'padding': 6, 'curve': 'basis'}, 'themeVariables': {'fontSize': '14px'}}}%%
flowchart TD
    CARTA(["Carta NOM-035<br/>+ metadata.proveedor (opcional)"]):::storage --> GRATIS

    subgraph GRATIS["1 · Capas gratis (deterministas, sin modelo)"]
        direction TB
        G1["Estructura del PDF<br/>¿captura de papel o composición digital?"]:::compute
        G2["Pixeles<br/>ruido de fondo de la hoja"]:::compute
        G3["Regiones candidatas<br/>el CÓDIGO calcula DÓNDE<br/>(objetos de imagen del PDF o tinta que no es texto)"]:::compute
        G1 --> G2 --> G3
    end

    GRATIS --> LOCATE["2 · VISIÓN · locate (Bedrock, Haiku 4.5)<br/>página + recortes candidatos<br/>el modelo solo dice QUÉ es cada uno"]:::ml
    LOCATE --> CROPS["Recortes de FIRMA · SELLO · LOGO<br/>+ huella de tinta 32x32"]:::compute
    CROPS --> KEY{"¿La carga trae<br/>proveedor?"}:::decision

    KEY -->|"SÍ"| LIST["DynamoDB: referencias ACTIVAS<br/>de ese proveedor, por elemento"]:::database
    LIST --> N{"¿Más de 3<br/>de ese elemento?"}:::decision
    N -->|"NO (lo normal)"| TODAS["Se mandan TODAS<br/>sin embedding, costo extra $0"]:::compute
    N -->|"SÍ"| EMB1["EMBEDDING del recorte<br/>(Titan Multimodal, 1 imagen)<br/>coseno contra el vector guardado<br/>de cada referencia → las 3 mejores"]:::rag
    EMB1 -.->|"sin vectores del modelo actual"| HUELLA["Respaldo: huella de tinta<br/>(o el orden guardado)"]:::compute

    KEY -->|"NO"| SEARCH{"¿references.search<br/>activo en el catálogo?"}:::decision
    SEARCH -->|"NO (hoy en CARTA_NOM35)"| SINREF["Sin comparación<br/>solo presencia y no-inserción<br/>SIN_CLAVE_DE_REFERENCIAS"]:::compute
    SEARCH -->|"SÍ"| EMB2["EMBEDDING del recorte<br/>→ S3 Vectors: vecinos de TODOS<br/>los proveedores (filtro scope + elemento + modelo)<br/>similitud ≥ min_similarity"]:::rag
    EMB2 --> VERIF["Cada candidata se confirma<br/>contra DynamoDB (fuente de verdad)"]:::database

    TODAS --> INSPECT
    EMB1 --> INSPECT
    HUELLA --> INSPECT
    VERIF --> INSPECT
    SINREF --> INSPECT

    INSPECT["3 · VISIÓN · inspect (Bedrock, Haiku 4.5)<br/>recorte a resolución nativa + imágenes de referencia (S3)<br/>¿indicios de inserción? · leyenda del sello ·<br/>¿a CUÁL referencia corresponde, o a NINGUNA?"]:::ml

    INSPECT --> SIG["Señales<br/>*_PRESENTE · *_SIN_INSERCION · SELLO_CORRESPONDE_EMISOR<br/>*_COINCIDE_REFERENCIA · PROVEEDOR_SUGERIDO"]:::compute
    SIG --> MEM["4 · Memoria entre cartas (DynamoDB)<br/>¿la misma tinta o imagen en la carta de otro empleado?"]:::database
    MEM --> RULES["Motor de reglas · on_fail del catálogo"]:::compute
    RULES --> OUT(["APROBADO · REQUIERE_REVISION · RECHAZADO"]):::storage

    FALLO["Referencias que existen pero no se pudieron leer<br/>→ campo VACÍO + REFERENCIAS_NO_DISPONIBLES<br/>→ revisión (nunca un falso 'no coincide')"]:::warn
    LIST -.-> FALLO
    INSPECT -.-> FALLO
    FALLO -.-> RULES

    classDef compute fill:#ED7100,stroke:#9D4E00,color:#fff,font-weight:bold
    classDef storage fill:#7AA116,stroke:#4B6B0B,color:#fff,font-weight:bold
    classDef database fill:#3B48CC,stroke:#232B85,color:#fff,font-weight:bold
    classDef ml fill:#01A88D,stroke:#016657,color:#fff,font-weight:bold
    classDef rag fill:#8C4FFF,stroke:#5A2DB5,color:#fff,font-weight:bold
    classDef decision fill:#F2F2F2,stroke:#666,color:#111
    classDef warn fill:#FDECEC,stroke:#C62828,color:#111

    style GRATIS fill:transparent,stroke:#ED7100,stroke-width:1px,stroke-dasharray: 3 3,color:#333
