# Plantillas de entorno. Copia a:
#   .env.production  → usado por deploy:prod  (dominio + WAF + API keys)
#   .env.dev         → usado por deploy:dev   (abierto, DNS random de Amazon)
# Las variables del sistema tienen prioridad sobre estos archivos.
# (Ambos .env.* están gitignored.)

# Modelo de Bedrock para clasificación y extracción
BEDROCK_MODEL_ID=us.anthropic.claude-haiku-4-5-20251001-v1:0

# AWS Account y Region para deploy
CDK_DEFAULT_REGION=us-east-1
CDK_DEFAULT_ACCOUNT=123451784011

# Tabla DynamoDB del catálogo (para scripts sync / sync:one)
CATALOG_TABLE=document-validation-catalog

# Region para scripts CLI
AWS_REGION=us-east-1

# --- Solo PROD: dominio propio (deja vacío/omite en dev) --------------------
# Dominio del API. En dev NO se usa (queda el URL execute-api random).
DOMAIN_NAME=idp.alsuper.com
# ARN del certificado en ACM. Impórtalo con:
#   node scripts/import-cert.mjs --cert idp.cert --key idp.key --chain chain.pem
# y pega aquí el ARN que imprime.
CERT_ARN=arn:aws:acm:us-east-1:123456789012:certificate/xxxxxxxx-xxxx-xxxx
# --- Recuperación por QR (pipeline/qr_recovery.py) ---------------------------
# true  (default): usa el QR embebido del pedimento para corregir PATENTE /
#                  NUMERO_CONSECUTIVO / ANIO_PEDIMENTO / ADUANA_DESPACHO.
# false: vuelve al comportamiento anterior (solo regex sobre el texto vía
#        _recover_references) — útil para comparar A/B o si prefieres el
#        escaneo viejo.
QR_RECOVERY_ENABLED=true