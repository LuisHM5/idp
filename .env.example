# Plantillas de entorno. Copia a:
#   .env.production  → usado por deploy:prod  (dominio + WAF + API keys)
#   .env.dev         → usado por deploy:dev   (abierto, DNS random de Amazon)
# Las variables del sistema tienen prioridad sobre estos archivos.
# (Ambos .env.* están gitignored.)

# --- Modelos de Bedrock -----------------------------------------------------
# Todas las llamadas usan la API Converse, que es agnóstica del proveedor, así
# que sirve CUALQUIER modelo alojado en Bedrock (Anthropic, Qwen, Nova, ...).
#
# Modelo base de todos los pasos. Con solo esta variable ya queda configurado
# el pipeline completo.
BEDROCK_MODEL_ID=us.anthropic.claude-haiku-4-5-20251001-v1:0

# Overrides por paso (opcionales). Si los omites, el paso usa el modelo base.
# Sirven para bajar costo donde no hace falta precisión, o subirla donde sí.
#
#   Paso                          | Variable                          | ¿Visión?
#   ------------------------------|-----------------------------------|--------
#   Clasificación (flujo estándar)| BEDROCK_CLASSIFICATION_MODEL_ID   | SÍ
#   Extracción    (flujo estándar)| BEDROCK_PROCESSING_MODEL_ID       | SÍ
#   Segmentación del expediente   | BEDROCK_SEGMENTER_MODEL_ID        | no
#   Extracción por documento      | BEDROCK_EXTRACTOR_MODEL_ID        | no
#   Re-extracción Textract+modelo | BEDROCK_RECOVERY_MODEL_ID         | no
#
# Los pasos del expediente corren sobre texto (OCR de Textract o texto nativo
# del PDF), nunca sobre imágenes: ahí funciona un modelo SIN visión. Los dos
# pasos del flujo estándar sí reciben el documento como imagen/PDF y necesitan
# un modelo multimodal.
#
# Descomenta solo los pasos que quieras mover:
# BEDROCK_CLASSIFICATION_MODEL_ID=
# BEDROCK_PROCESSING_MODEL_ID=
# BEDROCK_SEGMENTER_MODEL_ID=
# BEDROCK_EXTRACTOR_MODEL_ID=
# BEDROCK_RECOVERY_MODEL_ID=
#
# Capacidades verificadas contra la API en us-east-1 (no según docs):
#   modelo                                  converse tool cache vision
#   amazon.nova-lite-v1:0                      SI     SI   SI    SI
#   amazon.nova-pro-v1:0                       SI     SI   SI    SI
#   us.anthropic.claude-haiku-4-5-...          SI     SI   SI    SI
#   qwen.qwen3-vl-235b-a22b                    SI     SI   NO    SI
#   qwen.qwen3-32b-v1:0 / qwen3-next-80b-a3b   SI     SI   NO    solo texto
#   mistral.mistral-large-3-675b-instruct      SI     SI   NO    SI
#
# OJO: qwen.qwen3-235b-a22b-2507-v1:0 NO existe en us-east-1 (ahí la 235B es
# la variante -vl). Verifica con:
#   aws bedrock list-foundation-models --region us-east-1
#
# Ejemplo — Nova Lite (soporta todo, incluido caché) en todos los pasos:
#   BEDROCK_MODEL_ID=amazon.nova-lite-v1:0
#
# ANTES de mover un paso a otro modelo, verifica que ese modelo soporte lo que
# el paso usa — Bedrock no garantiza paridad entre los modelos que aloja:
#   - Converse                → lo usan todos; sin él, falla la llamada.
#   - Tool use forzado        → lo usa la extracción por documento (catálogos
#                               de 100+ campos). Sin él degrada a JSON libre.
#   - Prompt caching          → Bedrock RECHAZA la petición si el modelo no lo
#                               soporta (no la ignora). El pipeline lo detecta y
#                               reintenta sin caché, así que funciona igual —
#                               pero pierdes el descuento y el costo real sube
#                               aunque el precio por token baje.
#   - Visión                  → solo los dos pasos del flujo estándar.
#   - Ventana de contexto     → si difiere mucho, retunear MAX_MODEL_DOC_BYTES.
#
# Además: habilita "Model access" para esa familia de modelo en la consola de
# Bedrock (paso manual por cuenta/región, no se automatiza desde CDK ni IAM), y
# recuerda que cambiar cualquiera de estas variables requiere REDEPLOY (se
# hornean en la Lambda al desplegar).
#
# Este proyecto valida pedimentos: corre la suite contra
# tests/integration/expected_pedimentos.json antes de confiar un modelo nuevo.

# Byte máximo por documento en el flujo estándar antes de degradar al pipeline
# de expediente. El default (3.5 MB) está calibrado para una ventana de ~200K
# tokens; ajústalo si mueves ese flujo a un modelo con otra ventana.
# MAX_MODEL_DOC_BYTES=3500000

# Fuerza el JSON con una tool call en vez de pedirlo como texto libre. Más
# confiable entre familias de modelos, pero cambia cómo se invoca: déjalo
# apagado hasta verificar el camino de texto plano con el modelo destino.
# MODEL_INVOKE_STRUCTURED=true

# Guarda en disco cada request/response del modelo, un JSON por llamada, para
# ver qué devolvió exactamente (qué campo inventó, cuál omitió, cómo formó el
# JSON). Útil para comparar dos modelos sobre el mismo documento. Solo para
# depurar — no lo actives en producción. Ejemplo:
#   BEDROCK_MODEL_ID=amazon.nova-pro-v1:0 \
#   MODEL_RESPONSE_DUMP_DIR=$PWD/data/responses pnpm run procesar
# MODEL_RESPONSE_DUMP_DIR=

# AWS Account y Region para deploy
CDK_DEFAULT_REGION=us-east-1
CDK_DEFAULT_ACCOUNT=123451784011

# Tabla DynamoDB del catálogo (para scripts sync / sync:one)
CATALOG_TABLE=document-validation-catalog

# Region para scripts CLI
AWS_REGION=us-east-1

# --- Solo PROD: dominio propio (deja vacío/omite en dev) --------------------
# Dominio del API. En dev NO se usa (queda el URL execute-api random).
DOMAIN_NAME=idp.alsuper.com
# ARN del certificado en ACM. Impórtalo con:
#   node scripts/import-cert.mjs --cert idp.cert --key idp.key --chain chain.pem
# y pega aquí el ARN que imprime.
CERT_ARN=arn:aws:acm:us-east-1:123456789012:certificate/xxxxxxxx-xxxx-xxxx
# --- Solo DEV: exigir x-api-key igual que prod -------------------------------
# false (default): dev queda abierto, sin api key (fácil de probar).
# true: dev exige x-api-key en cada método, igual que prod — las apps/keys se
#       registran igual en ambos casos con `pnpm apps:register -- --env dev`
#       (nunca se gestionan aquí ni en el stack CDK). Cambiar esto requiere
#       redeploy (`pnpm run deploy:dev`); no hay toggle en caliente.
DEV_API_KEY_REQUIRED=false

# API key de UNA app dedicada a scripts locales (pnpm enviar, test:e2e:pedimento,
# test-e2e), usada AUTOMÁTICAMENTE por esos scripts cuando detectan
# DEV_API_KEY_REQUIRED=true arriba — así no hay que exportar API_KEY=... a mano
# cada vez que pruebas en dev con la protección activada. Un API_KEY exportado
# en el shell (o pasado explícito) siempre gana sobre esto. Regístrala una vez:
#   pnpm apps:register -- --name local-scripts --env dev
# y pega aquí el valor que imprime (no el ApiKeyId, el valor real de la key).
# No aplica a prod: ahí siempre hay que pasar API_KEY explícito a propósito.
# API_KEY_APP=

# --- Recuperación por QR (pipeline/qr_recovery.py) ---------------------------
# true  (default): usa el QR embebido del pedimento para corregir PATENTE /
#                  NUMERO_CONSECUTIVO / ANIO_PEDIMENTO / ADUANA_DESPACHO.
# false: vuelve al comportamiento anterior (solo regex sobre el texto vía
#        _recover_references) — útil para comparar A/B o si prefieres el
#        escaneo viejo.
QR_RECOVERY_ENABLED=true