  "document_types": {
    "EXPEDIENTE_ADUANAL_MULTIDOCUMENTO": {
      "description": "Archivo PDF que contiene varios documentos relacionados con una misma operación de comercio exterior. Puede incluir factura de agencia, pedimento, CFDI, comprobantes de pago, documentos de transporte, permisos y anexos VUCEM.",
      "business_destination": "EXPEDIENTE_COMPLETO",
      "extraction_fields": [
        "NUMERO_PEDIMENTO_PRINCIPAL",
        "RFC_IMPORTADOR",
        "REFERENCIA_OPERACION",
        "TOTAL_PAGES",
        "DETECTED_DOCUMENTS"
      ],
      "repeatable_fields": {
        "DETECTED_DOCUMENTS": [
          "DOCUMENT_TYPE",
          "DOCUMENT_SUBTYPE",
          "PAGE_START",
          "PAGE_END",
          "CONFIDENCE",
          "PEDIMENTO_REFERENCE",
          "UUID",
          "FOLIO"
        ]
      },
      "extraction_hints": {
        "DETECTED_DOCUMENTS": "Separar el PDF por rangos de páginas. Un cambio fuerte de diseño, emisor, folio, UUID, título o numeración de páginas normalmente indica el inicio de otro documento.",
        "NUMERO_PEDIMENTO_PRINCIPAL": "Elegir el número de pedimento que aparece repetido en la mayoría de los documentos del expediente."
      },
      "required_fields": ["DETECTED_DOCUMENTS"],
      "validation_rules": [
        {
          "field": "DETECTED_DOCUMENTS",
          "rule_type": "minimum_items",
          "value": 1,
          "message": "No fue posible identificar documentos dentro del expediente"
        },
        {
          "field": "DETECTED_DOCUMENTS",
          "rule_type": "page_ranges_no_overlap",
          "message": "Los rangos de páginas clasificados se traslapan"
        }
      ],
      "validator_module": "validators.customs.document_segmentation"
    },
    "PEDIMENTO_ADUANAL": {
      "description": "Pedimento de importación o exportación. Generalmente contiene encabezado de la operación, importador, agente aduanal, valores, incrementables, contribuciones, facturas, identificadores y partidas de mercancía.",
      "business_destination": "PEDIMENTO",
      "extraction_fields": [
        "NUMERO_PEDIMENTO",
        "NUMERO_PEDIMENTO_NORMALIZADO",
        "ANIO_PEDIMENTO",
        "ADUANA_DESPACHO",
        "SECCION_ADUANERA",
        "PATENTE",
        "NUMERO_CONSECUTIVO",
        "TIPO_OPERACION",
        "CLAVE_PEDIMENTO",
        "REGIMEN_ADUANERO",
        "DESTINO_ORIGEN",
        "TIPO_CAMBIO",
        "PESO_BRUTO",
        "MEDIO_TRANSPORTE_ENTRADA",
        "MEDIO_TRANSPORTE_ARRIBO",
        "MEDIO_TRANSPORTE_SALIDA",
        "VALOR_DOLARES",
        "VALOR_ADUANA",
        "PRECIO_PAGADO_VALOR_COMERCIAL",
        "RFC_IMPORTADOR_EXPORTADOR",
        "NOMBRE_IMPORTADOR_EXPORTADOR",
        "CURP_IMPORTADOR_EXPORTADOR",
        "DOMICILIO_IMPORTADOR_EXPORTADOR",
        "PAIS_VENDEDOR_COMPRADOR",
        "PAIS_ORIGEN_DESTINO",
        "FECHA_ENTRADA",
        "FECHA_PAGO",
        "FECHA_PRESENTACION",
        "SEGUROS",
        "FLETES",
        "EMBALAJES",
        "OTROS_INCREMENTABLES",
        "TRANSPORTE_DECREMENTABLE",
        "SEGURO_DECREMENTABLE",
        "CARGA_DECREMENTABLE",
        "DESCARGA_DECREMENTABLE",
        "OTROS_DECREMENTABLES",
        "TOTAL_EFECTIVO",
        "TOTAL_OTROS",
        "TOTAL_PEDIMENTO",
        "LINEA_CAPTURA",
        "BANCO",
        "OPERACION_BANCARIA",
        "FECHA_PAGO_BANCARIO",
        "IMPORTE_PAGADO",
        "FACTURAS",
        "CONTRIBUCIONES",
        "IDENTIFICADORES",
        "CONTENEDORES",
        "PARTIDAS"
      ],
      "repeatable_fields": {
        "FACTURAS": [
          "NUMERO_FACTURA",
          "FECHA_FACTURA",
          "INCOTERM",
          "MONEDA",
          "FACTOR_MONEDA",
          "VALOR_MONEDA_EXTRANJERA",
          "VALOR_DOLARES",
          "PROVEEDOR_COMPRADOR"
        ],
        "CONTRIBUCIONES": [
          "CLAVE_CONTRIBUCION",
          "DESCRIPCION",
          "FORMA_PAGO",
          "TASA",
          "IMPORTE"
        ],
        "IDENTIFICADORES": [
          "CLAVE_IDENTIFICADOR",
          "COMPLEMENTO_1",
          "COMPLEMENTO_2",
          "COMPLEMENTO_3"
        ],
        "CONTENEDORES": ["NUMERO_CONTENEDOR", "TIPO_CONTENEDOR", "SELLO"],
        "PARTIDAS": [
          "NUMERO_PARTIDA",
          "FRACCION_ARANCELARIA",
          "NICO",
          "DESCRIPCION_MERCANCIA",
          "CANTIDAD_UMC",
          "UNIDAD_UMC",
          "CANTIDAD_UMT",
          "UNIDAD_UMT",
          "PAIS_ORIGEN",
          "PAIS_VENDEDOR",
          "VALOR_ADUANA",
          "IMPORTE_PRECIO_PAGADO",
          "PRECIO_UNITARIO",
          "CONTRIBUCIONES_PARTIDA"
        ]
      },
      "extraction_hints": {
        "NUMERO_PEDIMENTO": "Formato visual habitual: AA ADUANA PATENTE CONSECUTIVO, por ejemplo '26 07 3435 6041248'.",
        "NUMERO_PEDIMENTO_NORMALIZADO": "Eliminar espacios, guiones y caracteres no numéricos. El resultado esperado contiene 15 dígitos.",
        "CLAVE_PEDIMENTO": "Clave corta como A1, V1, K1 o similar. No confundir con el régimen aduanero.",
        "VALOR_ADUANA": "Valor comercial más incrementables menos decrementables, sujeto a reglas y redondeos del pedimento.",
        "PRECIO_PAGADO_VALOR_COMERCIAL": "Puede aparecer como 'PRECIO PAGADO', 'VALOR COMERCIAL' o ambos.",
        "CONTRIBUCIONES": "Extraer todos los conceptos del cuadro de liquidación, incluyendo DTA, IVA, IGI, PRV, IVA/PRV, IEPS, CC, ECI, MT u otros.",
        "PARTIDAS": "Extraer todas las partidas y no únicamente la primera. Cada partida debe mantener sus contribuciones asociadas."
      },
      "required_fields": [
        "NUMERO_PEDIMENTO_NORMALIZADO",
        "PATENTE",
        "TIPO_OPERACION",
        "CLAVE_PEDIMENTO",
        "TIPO_CAMBIO",
        "VALOR_ADUANA",
        "PRECIO_PAGADO_VALOR_COMERCIAL",
        "RFC_IMPORTADOR_EXPORTADOR",
        "FECHA_PAGO",
        "TOTAL_PEDIMENTO"
      ],
      "validation_rules": [
        {
          "field": "NUMERO_PEDIMENTO_NORMALIZADO",
          "rule_type": "regex",
          "pattern": "^\\d{15}$",
          "message": "El número de pedimento normalizado debe contener 15 dígitos"
        },
        {
          "field": "RFC_IMPORTADOR_EXPORTADOR",
          "rule_type": "regex",
          "pattern": "^[A-ZÑ&]{3,4}\\d{6}[A-Z0-9]{3}$",
          "message": "RFC del importador o exportador inválido"
        },
        {
          "field": "VALOR_ADUANA",
          "rule_type": "custom_formula",
          "formula": "PRECIO_PAGADO_VALOR_COMERCIAL + SEGUROS + FLETES + EMBALAJES + OTROS_INCREMENTABLES - TRANSPORTE_DECREMENTABLE - SEGURO_DECREMENTABLE - CARGA_DECREMENTABLE - DESCARGA_DECREMENTABLE - OTROS_DECREMENTABLES",
          "tolerance": 5,
          "message": "El valor en aduana no coincide con el valor comercial y sus ajustes"
        },
        {
          "field": "TOTAL_PEDIMENTO",
          "rule_type": "sum_array",
          "source": "CONTRIBUCIONES.IMPORTE",
          "tolerance": 1,
          "message": "El total del pedimento no coincide con la suma de contribuciones"
        }
      ],
      "validator_module": "validators.customs.pedimento"
    },
    "FACTURA_AGENCIA_ADUANAL": {
      "description": "CFDI emitido por una agencia aduanal. Incluye honorarios, gastos complementarios, CAAAREM, precintos, COVE, UVA y otros servicios relacionados con el despacho.",
      "business_destination": "FACTURA_AGENCIA_ADUANAL",
      "field_sets": ["COMMON_CFDI_FIELDS"],
      "extraction_fields": [
        "FOLIO_INTERNO",
        "REFERENCIA_EMBARQUE",
        "PEDIMENTO_REFERENCE",
        "TIPO_OPERACION",
        "VALOR_ADUANA_REFERENCIADO",
        "PESO_BRUTO",
        "BULTOS",
        "CONTENEDORES",
        "GASTOS_CUENTA_TERCEROS",
        "TOTAL_SERVICIOS_AGENCIA",
        "TOTAL_GASTOS_TERCEROS",
        "TOTAL_FACTURA_MAS_GASTOS",
        "PAGOS_A_CUENTA",
        "PENDIENTE_DEPOSITAR",
        "SALDO_CFDI"
      ],
      "repeatable_fields": {
        "CONCEPTOS": [
          "CLAVE_PRODUCTO_SERVICIO",
          "CANTIDAD",
          "CLAVE_UNIDAD",
          "UNIDAD",
          "DESCRIPCION",
          "VALOR_UNITARIO",
          "IMPORTE",
          "DESCUENTO",
          "OBJETO_IMPUESTO",
          "BASE",
          "IMPUESTO",
          "TIPO_FACTOR",
          "TASA_CUOTA",
          "IMPORTE_IMPUESTO"
        ],
        "GASTOS_CUENTA_TERCEROS": [
          "CATEGORIA_GASTO",
          "CONCEPTO",
          "NUMERO_FACTURA",
          "PAGO_CLIENTE",
          "PAGO_AGENTE_ADUANAL",
          "IMPORTE"
        ]
      },
      "extraction_hints": {
        "PEDIMENTO_REFERENCE": "Buscar en campos como 'Pedimento', 'Referencia', 'SDV Ref.', 'Observaciones' o dentro de conceptos.",
        "GASTOS_CUENTA_TERCEROS": "Extraer cada renglón del desglose, aunque el número de factura esté vacío.",
        "TOTAL_SERVICIOS_AGENCIA": "Importe correspondiente exclusivamente a los servicios facturados por la agencia.",
        "TOTAL_FACTURA_MAS_GASTOS": "Total combinado del CFDI y los gastos pagados por cuenta del cliente."
      },
      "required_fields": [
        "UUID",
        "EMISOR_RFC",
        "RECEPTOR_RFC",
        "PEDIMENTO_REFERENCE",
        "CONCEPTOS",
        "SUBTOTAL",
        "TOTAL"
      ],
      "validation_rules": [
        {
          "field": "UUID",
          "rule_type": "regex",
          "pattern": "^[0-9A-Fa-f]{8}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{12}$",
          "message": "UUID del CFDI inválido"
        },
        {
          "field": "TOTAL",
          "rule_type": "cfdi_total",
          "formula": "SUBTOTAL - DESCUENTO + TOTAL_IMPUESTOS_TRASLADADOS - TOTAL_IMPUESTOS_RETENIDOS",
          "tolerance": 0.02,
          "message": "El total del CFDI no coincide con subtotal, impuestos y retenciones"
        },
        {
          "field": "RECEPTOR_RFC",
          "rule_type": "expected_value_by_app",
          "message": "El RFC receptor no corresponde a la empresa configurada"
        }
      ],
      "validator_module": "validators.customs.customs_broker_invoice"
    },
    "CUENTA_GASTOS_AGENTE_ADUANAL": {
      "description": "Resumen o cuenta de gastos del agente aduanal que concentra honorarios y pagos realizados por cuenta del importador.",
      "business_destination": "FACTURA_AGENCIA_ADUANAL",
      "extraction_fields": [
        "AGENTE_ADUANAL_NOMBRE",
        "AGENTE_ADUANAL_RFC",
        "IMPORTADOR_NOMBRE",
        "IMPORTADOR_RFC",
        "NUMERO_PEDIMENTO",
        "REFERENCIA",
        "FECHA",
        "HONORARIOS",
        "IVA_HONORARIOS",
        "ISR_RETENIDO",
        "IVA_RETENIDO",
        "TOTAL_HONORARIOS_NETO",
        "GASTOS_RESUMEN",
        "TOTAL_GASTOS_TERCEROS",
        "TOTAL_GENERAL",
        "ANTICIPO",
        "SALDO"
      ],
      "repeatable_fields": {
        "GASTOS_RESUMEN": [
          "CATEGORIA",
          "DESCRIPCION",
          "IMPORTE",
          "DOCUMENTO_SOPORTE_ESPERADO"
        ]
      },
      "extraction_hints": {
        "GASTOS_RESUMEN": "Normalizar conceptos como IMPUESTOS ADUANALES, MUESTREO, PAGO DE DERECHOS, PUNTO DE INSPECCION, LOGISTICA, ALMACENAJE y OTROS.",
        "TOTAL_GENERAL": "Debe corresponder a honorarios netos más gastos por cuenta de terceros, salvo que el formato indique otra composición."
      },
      "required_fields": [
        "IMPORTADOR_RFC",
        "NUMERO_PEDIMENTO",
        "GASTOS_RESUMEN",
        "TOTAL_GENERAL",
        "SALDO"
      ],
      "validation_rules": [
        {
          "field": "TOTAL_GASTOS_TERCEROS",
          "rule_type": "sum_array",
          "source": "GASTOS_RESUMEN.IMPORTE",
          "tolerance": 0.02,
          "message": "El total de gastos de terceros no coincide con el desglose"
        },
        {
          "field": "TOTAL_GENERAL",
          "rule_type": "custom_formula",
          "formula": "TOTAL_HONORARIOS_NETO + TOTAL_GASTOS_TERCEROS",
          "tolerance": 0.02,
          "message": "El total general no coincide con honorarios más gastos"
        },
        {
          "field": "SALDO",
          "rule_type": "custom_formula",
          "formula": "TOTAL_GENERAL - ANTICIPO",
          "tolerance": 0.02,
          "message": "El saldo no coincide con el total menos el anticipo"
        }
      ],
      "validator_module": "validators.customs.expense_account"
    },
    "CFDI_GASTO_TERCERO": {
      "description": "CFDI emitido por un tercero relacionado con el pedimento. Puede corresponder a muestreo, pago de derechos, punto de inspección, maniobras, almacenaje, logística u otros servicios.",
      "business_destination": "GASTOS_TERCEROS",
      "field_sets": ["COMMON_CFDI_FIELDS"],
      "extraction_fields": [
        "GASTO_TERCERO_CATEGORIA",
