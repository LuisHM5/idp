    "FACTURA_PROVEEDOR_EXTRANJERO": {
      "description": "Commercial invoice emitida por el proveedor extranjero de la mercancía. Normalmente no contiene UUID ni estructura CFDI.",
      "business_destination": "FACTURA_PROVEEDORES_EXTRANJEROS",
      "field_sets": ["COMMON_FOREIGN_INVOICE_FIELDS"],
      "extraction_fields": [
        "COUNTRY_OF_ORIGIN",
        "COUNTRY_OF_PROVENANCE",
        "EXPORTER_NAME",
        "MANUFACTURER_NAME",
        "CONSIGNEE",
        "NOTIFY_PARTY",
        "PACKAGES",
        "GROSS_WEIGHT",
        "NET_WEIGHT",
        "TOTAL_QUANTITY",
        "SIGNATURE_NAME",
        "SIGNED",
        "ITEMS"
      ],
      "repeatable_fields": {
        "ITEMS": [
          "LINE_NUMBER",
          "SKU",
          "DESCRIPTION",
          "HS_CODE",
          "COUNTRY_OF_ORIGIN",
          "QUANTITY",
          "UNIT",
          "UNIT_PRICE",
          "AMOUNT"
        ]
      },
      "extraction_hints": {
        "INVOICE_NUMBER": "Buscar Invoice No., Invoice Number, Commercial Invoice No. o Folio.",
        "PEDIMENTO_REFERENCE": "Puede no existir porque la factura normalmente se emite antes del pedimento.",
        "INCOTERM": "Extraer la clave y el lugar pactado, por ejemplo FOB El Paso o DAP Chihuahua.",
        "CURRENCY": "No asumir USD. Extraer la moneda expresamente indicada."
      },
      "required_fields": [
        "INVOICE_NUMBER",
        "INVOICE_DATE",
        "SELLER_NAME",
        "BUYER_NAME",
        "CURRENCY",
        "TOTAL",
        "ITEMS"
      ],
      "validation_rules": [
        {
          "field": "TOTAL",
          "rule_type": "custom_formula",
          "formula": "SUBTOTAL + FREIGHT_AMOUNT + INSURANCE_AMOUNT + OTHER_CHARGES + TAX_AMOUNT",
          "tolerance": 0.05,
          "message": "El total de la factura extranjera no coincide con sus componentes"
        },
        {
          "field": "TOTAL",
          "rule_type": "sum_array",
          "source": "ITEMS.AMOUNT",
          "comparison_field": "SUBTOTAL",
          "tolerance": 0.05,
          "message": "El subtotal no coincide con la suma de partidas"
        }
      ],
      "validator_module": "validators.customs.foreign_supplier_invoice"
    },
    "FACTURA_FLETE_EXTRANJERO": {
      "description": "Factura de transportista o proveedor extranjero por flete terrestre, marítimo o aéreo. Puede denominarse freight invoice, transportation invoice o trucking invoice.",
      "business_destination": "PAGO_FLETE_AMERICANO",
      "field_sets": ["COMMON_FOREIGN_INVOICE_FIELDS"],
      "extraction_fields": [
        "CARRIER_NAME",
        "CARRIER_TAX_ID",
        "SCAC_CODE",
        "BOL_NUMBER",
        "MASTER_BOL",
        "HOUSE_BOL",
        "TRAILER_NUMBER",
        "CONTAINER_NUMBER",
        "SEAL_NUMBER",
        "PICKUP_DATE",
        "DELIVERY_DATE",
        "ORIGIN",
        "DESTINATION",
        "ROUTE",
        "FREIGHT_AMOUNT",
        "FUEL_SURCHARGE",
        "ACCESSORIAL_CHARGES",
        "TOTAL"
      ],
      "repeatable_fields": {
        "ACCESSORIAL_CHARGES": ["DESCRIPTION", "QUANTITY", "RATE", "AMOUNT"]
      },
      "extraction_hints": {
        "FREIGHT_AMOUNT": "Extraer solamente el cargo de transporte principal cuando esté separado de combustible, espera, maniobras u otros cargos.",
        "BOL_NUMBER": "Buscar Bill of Lading, BOL, Load Number, Shipment Number o Reference Number."
      },
      "required_fields": [
        "INVOICE_NUMBER",
        "INVOICE_DATE",
        "CARRIER_NAME",
        "ORIGIN",
        "DESTINATION",
        "CURRENCY",
        "TOTAL"
      ],
      "validation_rules": [
        {
          "field": "TOTAL",
          "rule_type": "custom_formula",
          "formula": "FREIGHT_AMOUNT + FUEL_SURCHARGE + SUM(ACCESSORIAL_CHARGES.AMOUNT) + TAX_AMOUNT",
          "tolerance": 0.05,
          "message": "El total del flete no coincide con el desglose de cargos"
        }
      ],
      "validator_module": "validators.customs.foreign_freight_invoice"
    },
    "PERMISO_CERTIFICADO_SANITARIO": {
