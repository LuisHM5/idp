        "COMPROBANTE_PAGO_ADUANAL"
      ],
      "message": "Los documentos no corresponden al mismo pedimento"
    },
    {
      "rule_type": "expected_importer_rfc",
      "fields": [
        "RFC_IMPORTADOR_EXPORTADOR",
        "RECEPTOR_RFC",
        "IMPORTADOR_RFC",
        "RFC_PARA_CONSULTA"
      ],
      "message": "Uno o más documentos no pertenecen al importador configurado"
    },
    {
      "rule_type": "unique_cfdi_uuid",
      "documents": [
        "FACTURA_AGENCIA_ADUANAL",
        "CFDI_GASTO_TERCERO",
        "FACTURA_LOGISTICA"
      ],
      "message": "Se detectó un CFDI duplicado dentro del expediente"
    },
    {
      "rule_type": "expense_reconciliation",
      "summary_document": "CUENTA_GASTOS_AGENTE_ADUANAL",
      "detail_documents": [
        "CFDI_GASTO_TERCERO",
        "FACTURA_LOGISTICA",
        "COMPROBANTE_PAGO_ADUANAL"
      ],
      "group_by": "GASTO_TERCERO_CATEGORIA",
      "tolerance": 0.02,
      "message": "Los gastos resumidos por el agente aduanal no coinciden con sus documentos soporte"
    },
    {
      "rule_type": "pedimento_value_reconciliation",
      "pedimento_document": "PEDIMENTO_ADUANAL",
      "foreign_invoice_document": "FACTURA_PROVEEDOR_EXTRANJERO",
      "freight_document": "FACTURA_FLETE_EXTRANJERO",
      "message": "Los valores comerciales e incrementables no coinciden con las facturas del expediente"
    }
  ]
