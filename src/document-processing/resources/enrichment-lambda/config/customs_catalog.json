      "business_destination": "PERMISO_SALUD",
      "extraction_fields": [
        "AUTORIDAD_EMISORA",
        "TIPO_PERMISO",
        "NUMERO_PERMISO_CERTIFICADO",
        "FOLIO",
        "FECHA_EMISION",
        "FECHA_VIGENCIA_INICIO",
