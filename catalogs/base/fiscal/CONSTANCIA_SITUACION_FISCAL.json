              "regex": "Estatus\\s*en\\s*el\\s*padr[óo]n\\s*:[ \\t]*(?P<v>[A-ZÁÉÍÓÚÑ]+(?:[ \\t][A-ZÁÉÍÓÚÑ]+)*)[ \\t]*$",
