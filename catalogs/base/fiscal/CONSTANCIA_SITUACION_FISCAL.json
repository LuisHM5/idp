    "fields": {
      "RFC": {
        "type": "string",
        "required": true,
        "hint": "Registro Federal de Contribuyentes impreso junto a la etiqueta 'RFC' en la Cédula de Identificación Fiscal y repetido en 'Datos de Identificación del Contribuyente'. Extraer 12 caracteres para persona moral o 13 para persona física, en mayúsculas, sin espacios, guiones ni prefijos. NUNCA tomar la CURP, el idCIF ni un RFC mencionado dentro de la cadena original.",
        "qr_source": {
          "param": "d3",
          "split": "_",
          "part": -1,
          "pattern": "^[A-ZÑ&]{3,4}\\d{6}[A-Z0-9]{3}$"
        },
        "validation": [
          {
            "rule_type": "regex",
            "pattern": "^[A-ZÑ&]{3,4}\\d{6}[A-Z0-9]{3}$",
            "message": "El RFC no cumple el formato de 12 o 13 caracteres"
          }
        ],
        "text_source": {
          "selectors": [
            {
              "regex": "\\bRFC\\s*:\\s*(?P<v>[A-ZÑ&]{3,4}\\d{6}[A-Z0-9]{3})\\b",
              "group": "v",
              "flags": [
                "ignore_case"
              ],
              "region": {
                "start_regex": "Datos\\s*de\\s*Identificaci[óo]n\\s*del\\s*Contribuyente",
                "end_regex": "Datos\\s*del\\s*domicilio\\s*registrado",
                "flags": [
                  "ignore_case"
                ]
              },
              "transforms": [
                "upper"
              ]
            }
          ]
        }
      },
      "CURP": {
        "type": "string",
        "required": false,
        "hint": "CURP de 18 caracteres de una persona física, visible únicamente en 'Datos de Identificación del Contribuyente'. Extraer en mayúsculas y sin espacios. Para personas morales este campo no existe y debe quedar null; NUNCA sustituirlo con el RFC.",
        "validation": [
          {
            "rule_type": "regex",
            "pattern": "^[A-Z]{4}\\d{6}[HM][A-Z]{5}[A-Z0-9]\\d$",
            "message": "La CURP no cumple el formato de 18 caracteres"
          }
        ],
        "text_source": {
          "selectors": [
            {
              "regex": "\\bCURP\\s*:\\s*(?P<v>[A-Z]{4}\\d{6}[HMX][A-Z]{5}[A-Z0-9]\\d)\\b",
              "group": "v",
              "flags": [
                "ignore_case"
              ],
              "region": {
                "start_regex": "Datos\\s*de\\s*Identificaci[óo]n\\s*del\\s*Contribuyente",
                "end_regex": "Datos\\s*del\\s*domicilio\\s*registrado",
                "flags": [
                  "ignore_case"
                ]
              },
              "transforms": [
                "upper"
              ]
            }
          ]
        }
      },
      "NOMBRE_O_RAZON_SOCIAL": {
        "type": "string",
        "required": true,
        "hint": "Nombre completo visible en la Cédula de Identificación Fiscal o denominación/razón social impresa en los datos del contribuyente. Para persona física conservar nombres y apellidos tal como aparecen impresos; para persona moral conservar la denominación o razón social completa. No incluir el régimen de capital, RFC ni nombre comercial.",
        "validation": []
      },
      "NOMBRES": {
        "type": "string",
        "required": false,
        "hint": "Campo 'Nombre (s)' dentro de 'Datos de Identificación del Contribuyente'. Aplica a persona física; no copiar aquí una denominación o razón social.",
        "validation": []
      },
      "PRIMER_APELLIDO": {
        "type": "string",
        "required": false,
        "hint": "Campo 'Primer Apellido' de una persona física. Debe quedar null para persona moral o cuando el documento no lo muestre.",
        "validation": []
      },
      "SEGUNDO_APELLIDO": {
        "type": "string",
        "required": false,
        "hint": "Campo 'Segundo Apellido' de una persona física. Debe quedar null cuando no aparezca; no inferirlo a partir del nombre completo.",
        "validation": []
      },
      "REGIMEN_CAPITAL": {
        "type": "string",
        "required": false,
        "hint": "Campo 'Régimen Capital' de una persona moral, por ejemplo 'SOCIEDAD ANÓNIMA DE CAPITAL VARIABLE'. No confundir con los regímenes fiscales de la tabla 'Regímenes'.",
        "validation": []
      },
      "NOMBRE_COMERCIAL": {
        "type": "string",
        "required": false,
        "hint": "Campo 'Nombre Comercial' dentro de los datos de identificación. Conservarlo literal; no repetir la razón social cuando este campo esté vacío.",
        "validation": []
      },
      "ID_CIF": {
        "type": "string",
        "required": false,
        "hint": "Identificador idCIF asociado a la Cédula de Identificación Fiscal. Se recupera preferentemente de la parte anterior al guion bajo en el parámetro D3 del QR del SAT; si el QR no se decodifica, extraerlo únicamente cuando esté impreso. Conservar todos los dígitos como string y no confundirlo con RFC, CURP o folio.",
        "qr_source": {
          "param": "d3",
          "split": "_",
          "part": 0,
          "pattern": "^\\d+$"
        },
        "validation": [
          {
            "rule_type": "regex",
            "pattern": "^\\d+$",
            "message": "El idCIF debe contener únicamente dígitos"
          }
        ],
        "text_source": {
          "selectors": [
            {
              "regex": "\\bidCIF\\s*:\\s*(?P<v>\\d{6,})\\b",
              "group": "v",
              "flags": [
                "ignore_case"
              ]
            }
          ]
        }
      },
      "QR_CONSTANCIA": {
        "type": "string",
        "required": false,
        "computed": true,
        "hint": "URL completa decodificada del código QR de la Constancia de Situación Fiscal. Nunca inferir ni completar este campo: se llena determinísticamente desde el QR embebido y queda null cuando no puede decodificarse.",
        "qr_source": "payload",
        "validation": []
      },
      "CONSTANCIA_QR_VALIDO": {
        "type": "boolean",
        "required": true,
        "computed": true,
        "hint": "Verificación determinística del QR: true únicamente cuando el código apunta al validador del SAT y permite recuperar tanto ID_CIF como RFC desde el parámetro D3.",
        "qr_source": "valid",
        "qr_requires": [
          "ID_CIF",
          "RFC"
        ],
        "validation": [
          {
            "rule_type": "boolean_true",
            "message": "No se localizó un QR válido de Constancia de Situación Fiscal o no fue posible recuperar ID_CIF y RFC"
          }
        ]
      },
      "LUGAR_EMISION": {
        "type": "string",
        "required": false,
        "hint": "Lugar que aparece en la línea 'Lugar y Fecha de Emisión' del encabezado. Extraer solamente la localidad y entidad anteriores a la fecha, sin incluir la fecha ni el texto de la etiqueta.",
        "validation": [],
        "text_source": {
          "selectors": [
            {
              "regex": "(?:^|[ \\t]{2,})(?P<v>[A-ZÁÉÍÓÚÜÑ][A-ZÁÉÍÓÚÜÑ ,.]*?)\\s*A\\s*\\d{1,2}\\s*DE",
              "group": "v",
              "flags": [
                "multiline"
              ],
              "region": {
                "start_regex": "Lugar\\s*y\\s*Fecha\\s*de\\s*Emisi[óo]n",
                "end_regex": "Datos\\s*de\\s*Identificaci[óo]n\\s*del\\s*Contribuyente",
                "flags": [
                  "ignore_case"
                ]
              },
              "transforms": [
                {
                  "op": "regex_sub",
                  "pattern": "\\s*,\\s*",
                  "replacement": ", "
                },
                "collapse_whitespace"
              ]
            }
          ]
        }
      },
      "FECHA_EMISION": {
        "type": "date",
        "required": true,
        "hint": "Fecha de generación mostrada en 'Lugar y Fecha de Emisión' en la parte superior de la constancia. Normalizar a YYYY-MM-DD. NUNCA tomar la fecha de inicio de operaciones, la fecha de un régimen, actividad u obligación, ni una fecha contenida en la cadena original.",
        "validation": [
          {
            "rule_type": "date_max_age",
            "pattern": "5",
            "message": "La constancia supera la antigüedad máxima configurada de 5 años"
          }
        ],
        "text_source": {
          "selectors": [
            {
              "regex": "A\\s*(?P<v>\\d{1,2}\\s*DE(?:\\s+social)?\\s*(?:ENERO|FEBRERO|MARZO|ABRIL|MAYO|JUNIO|JULIO|AGOSTO|SEPTIEMBRE|OCTUBRE|NOVIEMBRE|DICIEMBRE)(?:\\s+social)?\\s*DE(?:\\s+social)?\\s*\\d{4})",
              "group": "v",
              "flags": [
                "ignore_case"
              ],
              "region": {
                "start_regex": "Lugar\\s*y\\s*Fecha\\s*de\\s*Emisi[óo]n",
                "end_regex": "Datos\\s*de\\s*Identificaci[óo]n\\s*del\\s*Contribuyente",
                "flags": [
                  "ignore_case"
                ]
              },
              "transforms": [
                {
                  "op": "regex_sub",
                  "pattern": "\\s*social\\s*",
                  "replacement": " ",
                  "flags": [
                    "ignore_case"
                  ]
                },
                {
                  "op": "regex_sub",
                  "pattern": "^\\s*(\\d{1,2})\\s*DE\\s*(ENERO|FEBRERO|MARZO|ABRIL|MAYO|JUNIO|JULIO|AGOSTO|SEPTIEMBRE|OCTUBRE|NOVIEMBRE|DICIEMBRE)\\s*DE\\s*(\\d{4})\\s*$",
                  "replacement": "\\1 DE \\2 DE \\3",
                  "flags": [
                    "ignore_case"
                  ]
                },
                "date_iso"
              ]
            },
            {
              "regex": "Cadena\\s*Original\\s*Sello\\s*:\\s*\\|\\|(?P<v>\\d{4}/\\d{2}/\\d{2})",
              "group": "v",
              "flags": [
                "ignore_case"
              ],
              "transforms": [
                {
                  "op": "regex_sub",
                  "pattern": "^(\\d{4})/(\\d{2})/(\\d{2})$",
                  "replacement": "\\1-\\2-\\3"
                },
                "date_iso"
              ]
            }
          ]
        }
      },
      "FECHA_INICIO_OPERACIONES": {
        "type": "date",
        "required": false,
        "hint": "Campo 'Fecha inicio de operaciones' dentro de 'Datos de Identificación del Contribuyente'. Normalizar a YYYY-MM-DD y no confundir con FECHA_EMISION.",
