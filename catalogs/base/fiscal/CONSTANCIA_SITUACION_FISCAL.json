              "regex": "Fecha\\s*inicio\\s*de\\s*operaciones\\s*:\\s*(?P<v>\\d{1,2}\\s*DE\\s*(?:ENERO|FEBRERO|MARZO|ABRIL|MAYO|JUNIO|JULIO|AGOSTO|SEPTIEMBRE|OCTUBRE|NOVIEMBRE|DICIEMBRE)\\s*DE\\s*\\d{4})",
