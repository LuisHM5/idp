      "DOMICILIO_FISCAL": {
        "type": "object",
        "required": true,
        "hint": "Bloque completo 'Datos del domicilio registrado'. Extraer cada dato de su etiqueta; no tomar direcciones presentes en sellos, cadenas originales u otros textos.",
