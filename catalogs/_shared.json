{
  "_schema_contract": {
    "schema_version": "2.0.0",
    "naming": "UPPER_SNAKE_CASE",
    "null_policy": "Campo no visible o ilegible: null. Lista sin elementos: []. No inventar valores.",
    "default_prompt_profile": "CLAUDE_HAIKU_JSON"
  },
  "_model_profiles": {
    "CLAUDE_HAIKU_JSON": {
      "include_schema_sections": [
        "description",
        "extraction_fields",
        "extraction_hints",
        "structured_fields",
        "repeatable_fields"
      ],
      "exclude_schema_sections": [
        "derived_fields",
        "validation_rules",
        "validator_module",
        "custom_validator",
        "output_aliases",
        "form_mapping",
        "business_destination",
        "pipeline"
      ],
      "response_rules": [
        "Devuelve solo JSON válido, sin Markdown ni explicación.",
        "Extrae únicamente valores visibles; no completes por conocimiento externo.",
        "Conserva folios, RFC, claves, patentes, pedimentos y códigos como string.",
        "No calcules campos derivados; los calcula el backend.",
        "Une continuaciones entre páginas y conserva el orden documental.",
        "Omite campos opcionales nulos; usa [] para listas detectadas sin filas."
      ]
    }
  },
  "_global_output_fields": [
    "DOCUMENT_TYPE",
    "DOCUMENT_SUBTYPE",
    "BUSINESS_CATEGORY",
    "SOURCE_FILE_NAME",
    "SOURCE_PAGE_START",
    "SOURCE_PAGE_END",
    "EXTRACTION_CONFIDENCE",
    "VALIDATION_STATUS",
    "REVIEW_REQUIRED",
    "WARNINGS"
  ],
  "_field_sets": {
    "COMMON_CFDI_FIELDS": [
      "VERSION_CFDI",
      "TIPO_COMPROBANTE",
      "SERIE",
      "FOLIO",
      "UUID",
      "FECHA_EMISION",
      "FECHA_CERTIFICACION",
      "LUGAR_EXPEDICION",
      "MONEDA",
      "TIPO_CAMBIO",
      "FORMA_PAGO",
      "METODO_PAGO",
      "CONDICIONES_PAGO",
      "EXPORTACION",
      "EMISOR_RFC",
      "EMISOR_NOMBRE",
      "EMISOR_REGIMEN_FISCAL",
      "EMISOR_DOMICILIO",
      "RECEPTOR_RFC",
      "RECEPTOR_NOMBRE",
      "RECEPTOR_REGIMEN_FISCAL",
      "RECEPTOR_CODIGO_POSTAL",
      "RECEPTOR_DOMICILIO",
      "USO_CFDI",
      "REFERENCIA_PEDIMENTO",
      "REFERENCIA_INTERNA",
      "MERCANCIA",
      "SUBTOTAL",
      "DESCUENTO",
      "IVA_TRASLADADO",
      "IEPS_TRASLADADO",
      "ISR_RETENIDO",
      "IVA_RETENIDO",
      "TOTAL_IMPUESTOS_TRASLADADOS",
      "TOTAL_IMPUESTOS_RETENIDOS",
      "TOTAL",
      "TOTAL_CON_LETRA",
      "ANTICIPO",
      "SALDO",
      "CERTIFICADO_EMISOR",
      "CERTIFICADO_SAT",
      "RFC_PROVEEDOR_CERTIFICACION",
      "SELLO_CFDI",
      "SELLO_SAT",
      "CADENA_ORIGINAL",
      "CONCEPTOS"
    ],
    "COMMON_FOREIGN_INVOICE_FIELDS": [
      "INVOICE_NUMBER",
      "INVOICE_DATE",
      "DUE_DATE",
      "SELLER_NAME",
      "SELLER_TAX_ID",
      "SELLER_ADDRESS",
      "SELLER_COUNTRY",
      "BUYER_NAME",
      "BUYER_TAX_ID",
      "BUYER_ADDRESS",
      "BUYER_COUNTRY",
      "CURRENCY",
      "EXCHANGE_RATE",
      "PAYMENT_TERMS",
      "INCOTERM",
      "PURCHASE_ORDER",
      "SHIPMENT_REFERENCE",
      "PEDIMENTO_REFERENCE",
      "SUBTOTAL",
      "FREIGHT_AMOUNT",
      "INSURANCE_AMOUNT",
      "OTHER_CHARGES",
      "TAX_AMOUNT",
      "TOTAL",
      "ITEMS"
    ]
  },
  "_validation_defaults": {
    "money_tolerance": 1.0,
    "ratio_tolerance": 0.02,
    "skip_if_missing": true
  },
  "_common_item_fields": {
    "__COMENTARIO__": "Subcampos que se repiten en casi todos los grupos repetibles del DSL nuevo (schema_version 4.x). Un item_fields los referencia por nombre con \"$common\": [...] en vez de volver a escribir su hint/type/validation cada vez. Solo los usan los tipos que ya migraron al DSL field-centric (ver catalogs/_TEMPLATE.json) — los tipos con el schema viejo (parallel arrays) los ignoran.",
    "PAGINA": {
      "type": "number",
      "required": false,
      "hint": "Número de página del documento donde aparece esta fila.",
      "validation": []
    },
    "ORDEN": {
      "type": "number",
      "required": false,
      "hint": "Posición de la fila dentro de su tabla, en el orden en que aparece impresa.",
      "validation": []
    },
    "CONFIANZA": {
      "type": "number",
      "required": false,
      "hint": "Confianza 0.0-1.0 reportada por el modelo para esta fila.",
      "validation": []
    },
    "VALOR_CRUDO": {
      "type": "string",
      "required": false,
      "hint": "Texto tal como aparece impreso en la fila, sin normalizar, para trazabilidad cuando el parseo estructurado sea ambiguo.",
      "validation": []
    }
  },
  "cross_document_validation_rules": [
    {
      "rule_type": "same_pedimento",
      "documents": [
        "PEDIMENTO_ADUANAL",
        "FACTURA_HONORARIOS",
        "FACTURA_AGENCIA_ADUANAL",
        "CUENTA_GASTOS_AGENTE_ADUANAL",
        "CFDI_GASTO_TERCERO",
        "FACTURA_LOGISTICA",
        "COMPROBANTE_PAGO_ADUANAL"
      ],
      "pedimento_paths": [
        "PEDIMENTO.NUMERO_NORMALIZADO",
        "DOCUMENTO.REFERENCIA",
        "PEDIMENTO_REFERENCE",
        "NUMERO_PEDIMENTO_NORMALIZADO"
      ],
      "message": "Los documentos no corresponden al mismo pedimento"
    },
    {
      "rule_type": "expected_importer_rfc",
      "fields": [
        "IMPORTADOR_EXPORTADOR.RFC",
        "RFC_IMPORTADOR_EXPORTADOR",
        "RECEPTOR_RFC",
        "IMPORTADOR_RFC",
        "RFC_PARA_CONSULTA"
      ],
      "message": "Uno o más documentos no pertenecen al importador configurado",
      "documents": [
        "PEDIMENTO_ADUANAL",
        "PEDIMENTO_ERP",
        "FACTURA_HONORARIOS",
        "FACTURA_AGENCIA_ADUANAL",
        "CUENTA_GASTOS_AGENTE_ADUANAL",
        "CFDI_GASTO_TERCERO",
        "FACTURA_LOGISTICA",
        "COMPROBANTE_PAGO_ADUANAL"
      ]
    },
    {
      "rule_type": "unique_cfdi_uuid",
      "documents": [
        "FACTURA_HONORARIOS",
        "FACTURA_AGENCIA_ADUANAL",
        "CFDI_GASTO_TERCERO",
        "FACTURA_LOGISTICA"
      ],
      "message": "Se detectó un CFDI duplicado dentro del expediente"
    },
    {
      "rule_type": "expense_reconciliation",
      "summary_document": "CUENTA_GASTOS_AGENTE_ADUANAL",
      "detail_documents": [
        "CFDI_GASTO_TERCERO",
        "FACTURA_LOGISTICA",
        "COMPROBANTE_PAGO_ADUANAL"
      ],
      "group_by": "GASTO_TERCERO_CATEGORIA",
      "tolerance": 0.02,
      "message": "Los gastos resumidos por el agente aduanal no coinciden con sus soportes"
    },
    {
      "rule_type": "pedimento_value_reconciliation",
      "pedimento_document": "PEDIMENTO_ADUANAL",
      "foreign_invoice_document": "FACTURA_PROVEEDOR_EXTRANJERO",
      "freight_document": "FACTURA_FLETE_EXTRANJERO",
      "value_paths": {
        "commercial_value": "VALORES.VALOR_COMERCIAL_PESOS",
        "exchange_rate": "VALORES.TIPO_CAMBIO",
        "freight": "INCREMENTABLES.FLETES"
      },
      "message": "Los valores comerciales e incrementables no coinciden con las facturas del expediente"
    }
  ]
}
