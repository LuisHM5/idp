    "extraction_hints": {
      "DOCUMENTO": "Subtipo, referencia y paginación. Une anexos y continuaciones que compartan referencia o número de pedimento.",
      "PEDIMENTO": "Encabezado principal: número impreso, operación, clave, régimen, destino, aduanas, sección, transportes, peso, aceptación, bultos y prevalidador. No descompongas ni normalices el número.",
      "IMPORTADOR_EXPORTADOR": "Bloque DATOS DEL IMPORTADOR/EXPORTADOR. No mezcles RFC o CURP del agente aduanal.",
      "VALORES": "Extrae TIPO CAMBIO, VALOR DOLARES, VALOR ADUANA y PRECIO PAGADO/VALOR COMERCIAL exactamente del encabezado.",
      "INCREMENTABLES": "Extrae VAL. SEGUROS, SEGUROS, FLETES, EMBALAJES y OTROS. VAL. SEGUROS es informativo y no es la prima SEGUROS.",
      "DECREMENTABLES": "Extrae transporte, seguro, carga, descarga y otros decrementables cuando aparezcan.",
      "FECHAS": "Extrae ENTRADA, PAGO, PRESENTACION y cualquier fecha adicional; normaliza a YYYY-MM-DD cuando sea inequívoca.",
      "TASAS_NIVEL_PEDIMENTO": "Una fila por tasa: contribución, tipo de tasa y valor. Conserva texto como Ex cuando no sea numérico.",
      "LIQUIDACION": "CUADRO DE LIQUIDACION de doble columna. Convierte cada mitad en un concepto independiente con fila y lado; conserva EFECTIVO, OTROS y TOTAL por separado.",
      "PAGO": "DEPOSITO REFERENCIADO o pago electrónico: línea de captura, banco, importe, fecha, operación, transacción SAT y medios.",
      "PROVEEDORES_COMPRADORES": "Extrae todos los bloques de proveedor/comprador y vincula sus facturas por orden y continuidad de página.",
      "FACTURAS": "Una fila por factura; asocia COVE/e-document aunque aparezca en el renglón siguiente o en otra página.",
      "TRANSPORTE": "Transportista, vehículo y guías/documentos de transporte. No confundas placas, VIN y número económico.",
      "CONTENEDORES": "Un registro por par número/tipo. Si la fila es ambigua, conserva TOKENS_CRUDOS y deja número/tipo en null.",
      "CANDADOS_SELLOS": "Extrae todos los candados o sellos y el equipo relacionado.",
      "IDENTIFICADORES": "Identificadores a nivel pedimento con clave y complementos 1, 2 y 3; conserva desplazamientos de fila.",
      "CUENTAS_ADUANERAS_GARANTIA": "Cuentas o garantías a nivel pedimento, con institución, folio, fechas e importes.",
      "DESCARGOS": "Pedimentos u operaciones originales descargados y cantidades asociadas.",
      "COMPENSACIONES": "Datos de compensación, gravamen, forma de pago e importe compensado.",
      "PEDIMENTOS_RELACIONADOS": "Pedimentos originales, rectificados, complementarios, consolidados o relacionados.",
      "RECTIFICACION": "Completa solo cuando el documento sea rectificación o muestre datos del pedimento original.",
      "CONSOLIDACION": "Completa solo cuando exista aviso consolidado, periodo o remesas.",
      "OBSERVACIONES": "Texto completo, sin resumir, uniendo renglones y continuaciones entre páginas.",
      "DOCUMENTOS_DIGITALIZADOS": "Referencias explícitas a COVE, e-document, factura, certificado, dictamen u otro documento digitalizado.",
      "REGULACIONES_RESTRICCIONES": "Permisos, NOM, certificados, inspecciones o restricciones; no inventes folios no impresos.",
      "CANDADO_FISCAL": "Distingue una leyenda SIN CANDADO FISCAL de un número de candado realmente impreso.",
      "PARTIDAS": "Una fila por partida, incluyendo descripción, fracción/NICO, unidades, países, valores y subtablas. Une continuaciones de la misma partida entre páginas.",
      "AGENTE_ADUANAL": "Figura, patente/autorización, RFC, CURP y nombre del bloque AGENTE ADUANAL/AGENCIA/APODERADO.",
      "CERTIFICACIONES": "Una fila por certificación. Si el recuadro existe pero está vacío, devuelve [].",
      "FIRMA": "Serie del certificado y presencia de firma electrónica/autógrafa. AUTOGRAFA_DETECTADA solo es true si hay trazo manuscrito.",
