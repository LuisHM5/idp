{
  "PEDIMENTO_ADUANAL": {
    "schema_version": "5.0.0",
    "display_name": "Pedimento Aduanal",
    "description": "Esquema mínimo para alimentar la captura general del pedimento, el cuadro de liquidación, las facturas relacionadas y el reporte de pedimento.",
    "prompt_profile": "CLAUDE_HAIKU_JSON",
    "min_confidence": 0.8,
    "fields": {
      "NUMERO_PEDIMENTO_NORMALIZADO": {
        "type": "string",
        "required": true,
        "hint": "Construir concatenando ANIO_PEDIMENTO + ADUANA_DESPACHO + PATENTE + NUMERO_CONSECUTIVO. Debe contener exactamente 15 dígitos y conservar todos los ceros (ej. 20260708236001130).",
        "validation": [
          {
            "rule_type": "regex",
            "pattern": "^\\d{15}$",
            "message": "El número de pedimento debe contener exactamente 15 dígitos"
          }
        ]
      },
      "ANIO_PEDIMENTO": {
        "type": "string",
        "required": true,
        "hint": "Año del número de pedimento en formato de 2 dígitos.",
        "validation": [
          {
            "rule_type": "regex",
            "pattern": "^\\d{2}$",
            "message": "El año del pedimento debe contener 2 dígitos"
          }
        ]
      },
      "ADUANA_DESPACHO": {
        "type": "string",
        "required": true,
        "hint": "Aduana contenida en el número de pedimento. Extraer 2 dígitos y conservar ceros iniciales.",
        "validation": [
          {
            "rule_type": "regex",
            "pattern": "^\\d{2}$",
            "message": "La aduana debe contener 2 dígitos"
          }
        ]
      },
      "PATENTE": {
        "type": "string",
        "required": true,
        "hint": "Patente o autorización del agente aduanal. Extraer como string de 4 dígitos.",
        "validation": [
          {
            "rule_type": "regex",
            "pattern": "^\\d{4}$",
            "message": "La patente debe contener 4 dígitos"
          }
        ]
      },
      "NUMERO_CONSECUTIVO": {
        "type": "string",
        "required": true,
        "hint": "Consecutivo del pedimento. Extraer exactamente 7 dígitos como string, sin eliminar ceros finales.",
        "validation": [
          {
            "rule_type": "regex",
            "pattern": "^\\d{7}$",
            "message": "El consecutivo debe contener 7 dígitos"
          }
        ]
      },
      "FECHA_ENTRADA": {
        "type": "date",
        "required": true,
        "hint": "Fecha marcada como ENTRADA en el pedimento. Normalizar a YYYY-MM-DD.",
        "validation": []
      },
      "FECHA_PAGO": {
        "type": "date",
        "required": false,
        "hint": "Fecha marcada como PAGO en el pedimento. Normalizar a YYYY-MM-DD.",
        "validation": []
      },
      "TIPO_OPERACION": {
        "type": "string",
        "required": true,
        "hint": "Código T.OPER o TIPO OPER. Normalmente IMP o EXP.",
        "validation": [
          {
            "rule_type": "in",
            "values": ["IMP", "EXP"],
            "message": "El tipo de operación debe ser IMP o EXP"
          }
        ]
      },
      "CLAVE_PEDIMENTO": {
        "type": "string",
        "required": true,
        "hint": "Campo CVE.PEDIMENTO o CVE.PEDIM, por ejemplo A1 o R1.",
        "validation": []
      },
      "TIPO_CAMBIO": {
        "type": "number",
        "required": true,
        "hint": "Tipo de cambio impreso en el encabezado.",
        "validation": [
          {
            "rule_type": "greater_than",
            "value": 0,
            "message": "El tipo de cambio debe ser mayor que cero"
          }
        ]
      },
      "PAIS_ORIGEN": {
        "type": "string",
        "required": false,
        "hint": "País de origen principal de las mercancías. Utilizarlo solamente cuando las partidas compartan el mismo país.",
        "validation": []
      },
      "VALOR_DOLARES": {
        "type": "number",
        "required": true,
        "hint": "Campo VALOR DOLARES del encabezado del pedimento.",
        "validation": []
      },
      "VALOR_ADUANA": {
        "type": "number",
        "required": true,
        "hint": "Campo VALOR ADUANA, normalmente expresado en pesos mexicanos.",
        "validation": []
      },
      "PRECIO_PAGADO_VALOR_COMERCIAL": {
        "type": "number",
        "required": true,
        "hint": "Campo PRECIO PAGADO/VALOR COMERCIAL. Se utiliza como Valor Comercial Pesos en la pantalla de captura.",
        "validation": []
      },
      "VALOR_SEGUROS": {
        "type": "number",
        "required": false,
        "default": 0,
        "hint": "Campo VAL. SEGUROS del bloque de gastos incrementables.",
        "validation": []
      },
      "SEGUROS": {
        "type": "number",
        "required": false,
        "default": 0,
        "hint": "Campo SEGUROS del bloque de gastos incrementables.",
        "validation": []
      },
      "FLETES": {
        "type": "number",
        "required": false,
        "default": 0,
        "hint": "Campo FLETES del bloque de gastos incrementables.",
        "validation": []
      },
      "EMBALAJES": {
        "type": "number",
        "required": false,
        "default": 0,
        "hint": "Campo EMBALAJES del bloque de gastos incrementables.",
        "validation": []
      },
      "OTROS_INCREMENTABLES": {
        "type": "number",
        "required": false,
        "default": 0,
        "hint": "Campo OTROS INCREMENTABLES.",
        "validation": []
      },
      "CUADRO_LIQUIDACION": {
        "type": "object",
        "required": true,
        "hint": "Extraer todos los conceptos impresos en el cuadro de liquidación, incluyendo ambas mitades de la tabla.",
        "validation": [
          {
            "rule_type": "sum_array",
            "source": "CUADRO_LIQUIDACION.CONCEPTOS.IMPORTE",
            "subfield": "TOTAL",
            "tolerance": 1,
            "skip_if_missing": true,
            "message": "El total no coincide con la suma de conceptos"
          }
        ],
        "fields": {
          "CONCEPTOS": {
            "type": "array",
            "required": true,
            "hint": "Un registro por cada concepto encontrado en el cuadro de liquidación.",
            "validation": [],
            "item_fields": {
              "CONCEPTO": {
                "type": "string",
                "required": true,
                "hint": "Clave o nombre impreso, por ejemplo DTA, PRV, IVA PRV, IEPS, F.IEPS o 2IF.",
                "validation": []
              },
              "FORMA_PAGO": {
                "type": "string",
                "required": false,
                "hint": "Valor de la columna F.P. Conservarlo como string.",
                "validation": []
              },
              "TASA": {
                "type": "number",
                "required": false,
                "hint": "Tasa asociada al concepto cuando pueda determinarse, especialmente para IEPS.",
                "validation": []
              },
              "IMPORTE": {
                "type": "number",
                "required": true,
                "hint": "Importe del concepto.",
                "validation": []
              }
            }
          },
          "TOTAL_EFECTIVO": {
            "type": "number",
            "required": false,
            "default": 0,
            "hint": "Total EFECTIVO impreso.",
            "validation": []
          },
          "TOTAL_OTROS": {
            "type": "number",
            "required": false,
            "default": 0,
            "hint": "Total OTROS impreso.",
            "validation": []
          },
          "TOTAL": {
            "type": "number",
            "required": true,
            "hint": "TOTAL impreso en el cuadro de liquidación.",
            "validation": []
          }
        }
      },
      "LIQUIDACION_NORMALIZADA": {
        "type": "object",
        "required": false,
        "computed": true,
        "hint": "Objeto calculado a partir de CUADRO_LIQUIDACION. Los conceptos inexistentes deben regresar 0.00.",
        "validation": [],
        "fields": {
          "DTA": {
            "type": "number",
            "required": false,
            "default": 0,
            "concept_aliases": ["DTA"],
            "hint": "Suma de conceptos DTA.",
            "validation": []
          },
          "IGI": {
            "type": "number",
            "required": false,
            "default": 0,
            "concept_aliases": ["IGI", "IGE", "IGI/IGE"],
            "hint": "Suma de conceptos IGI, IGE o IGI/IGE.",
            "validation": []
          },
          "PRV": {
            "type": "number",
            "required": false,
            "default": 0,
            "concept_aliases": ["PRV"],
            "hint": "Suma de conceptos PRV.",
            "validation": []
          },
          "ECI": {
            "type": "number",
            "required": false,
            "default": 0,
            "concept_aliases": ["ECI"],
            "hint": "Suma de conceptos ECI.",
            "validation": []
          },
          "MT": {
            "type": "number",
            "required": false,
            "default": 0,
            "concept_aliases": ["MT"],
            "hint": "Suma de conceptos MT.",
            "validation": []
          },
          "CC": {
            "type": "number",
            "required": false,
            "default": 0,
            "concept_aliases": ["CC"],
            "hint": "Suma de conceptos CC.",
            "validation": []
          },
          "IVA": {
            "type": "number",
            "required": false,
            "default": 0,
            "concept_aliases": ["IVA", "IVA PRV", "IVA/PRV"],
            "hint": "Suma de IVA, IVA PRV e IVA/PRV. La pantalla concentra estos conceptos en un solo campo IVA.",
            "validation": []
          },
          "IEPS": {
            "type": "number",
            "required": false,
            "default": 0,
            "source": "PARTIDAS.CONTRIBUCIONES_PARTIDA",
            "filters": {"CLAVE_CONTRIBUCION": "IEPS"},
            "hint": "Importe total de los conceptos IEPS ordinarios.",
            "validation": []
          },
          "IEPS_8": {
            "type": "number",
            "required": false,
            "default": 0,
            "source": "PARTIDAS.CONTRIBUCIONES_PARTIDA",
            "filters": {"CLAVE_CONTRIBUCION": "IEPS", "TASA": 8},
            "hint": "IEPS correspondiente a la tasa del 8%.",
            "validation": []
          },
          "IEPS_26_5": {
            "type": "number",
            "required": false,
            "default": 0,
            "source": "PARTIDAS.CONTRIBUCIONES_PARTIDA",
            "filters": {"CLAVE_CONTRIBUCION": "IEPS", "TASA": 26.5},
            "hint": "IEPS correspondiente a la tasa del 26.5%.",
            "validation": []
          },
          "IEPS_30": {
            "type": "number",
            "required": false,
            "default": 0,
            "source": "PARTIDAS.CONTRIBUCIONES_PARTIDA",
            "filters": {"CLAVE_CONTRIBUCION": "IEPS", "TASA": 30},
            "hint": "IEPS correspondiente a la tasa del 30%.",
            "validation": []
          },
          "IEPS_50": {
            "type": "number",
            "required": false,
            "default": 0,
            "source": "PARTIDAS.CONTRIBUCIONES_PARTIDA",
            "filters": {"CLAVE_CONTRIBUCION": "IEPS", "TASA": 50},
            "hint": "IEPS correspondiente a la tasa del 50%.",
            "validation": []
          },
          "IEPS_25_CAFEINA": {
            "type": "number",
            "required": false,
            "default": 0,
            "source": "PARTIDAS.CONTRIBUCIONES_PARTIDA",
            "filters": {"CLAVE_CONTRIBUCION": "IEPS", "TASA": 25},
            "hint": "IEPS correspondiente al campo 25% CAFEÍNA.",
            "validation": []
          },
          "OTROS_IEPS": {
            "type": "number",
            "required": false,
            "default": 0,
            "source": "PARTIDAS.CONTRIBUCIONES_PARTIDA",
            "filters": {"CLAVE_CONTRIBUCION": "IEPS", "TASA_NOT_IN": [8, 25, 26.5, 30, 50]},
            "hint": "IEPS con una tasa distinta de 8, 25, 26.5, 30 o 50.",
            "validation": []
          },
          "F_IEPS": {
            "type": "number",
            "required": false,
            "default": 0,
            "concept_aliases": ["F.IEPS", "FIEPS"],
            "hint": "Importe del concepto impreso como F.IEPS o FIEPS. Es numérico; no representa la forma de pago.",
            "validation": []
          },
          "2IF": {
            "type": "number",
            "required": false,
            "default": 0,
            "concept_aliases": ["2IF"],
            "hint": "Importe del concepto impreso como 2IF.",
            "validation": []
          },
          "TOTAL_CONTRIBUCIONES": {
            "type": "number",
            "required": true,
            "source": "CUADRO_LIQUIDACION.TOTAL",
            "hint": "TOTAL impreso en el cuadro de liquidación.",
            "validation": []
          }
        }
      },
      "AGENTE_ADUANAL_NOMBRE": {
        "type": "string",
        "required": false,
        "hint": "Nombre o razón social del agente aduanal. Puede utilizarse como respaldo cuando no exista en el catálogo de patentes.",
        "validation": []
      },
      "FACTURAS": {
        "type": "array",
        "required": true,
        "hint": "Una fila por factura del pedimento. El proveedor debe mantenerse vinculado con cada factura.",
        "validation": [],
        "item_fields": {
          "NUMERO_FACTURA": {
            "type": "string",
            "required": true,
            "hint": "Número de factura impreso en el pedimento.",
            "validation": []
          },
          "FECHA": {
            "type": "date",
            "required": true,
            "hint": "Fecha de la factura. Normalizar a YYYY-MM-DD.",
            "validation": []
          },
          "PROVEEDOR_ID_FISCAL": {
            "type": "string",
            "required": true,
            "hint": "ID fiscal, Tax ID o RFC del proveedor. Se utilizará para buscar el código interno del proveedor.",
            "validation": []
          },
          "PROVEEDOR_NOMBRE": {
            "type": "string",
            "required": true,
            "hint": "Nombre, denominación o razón social del proveedor.",
            "validation": []
          },
          "VALOR_DOLARES": {
            "type": "number",
            "required": true,
            "hint": "Valor en dólares correspondiente a la factura.",
            "validation": []
          },
          "VALOR_MONEDA_NACIONAL": {
            "type": "number",
            "required": false,
            "computed": true,
            "hint": "Calcular como FACTURA.VALOR_DOLARES multiplicado por TIPO_CAMBIO, conservando 4 decimales.",
            "validation": []
          }
        }
      }
    }
  }
}
