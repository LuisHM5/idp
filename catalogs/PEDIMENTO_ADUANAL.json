    "derived_fields": {
      "PEDIMENTO.NUMERO_NORMALIZADO": {
        "source": "PEDIMENTO.NUMERO",
        "transform": "digits_only",
        "expected_length": 15
      },
      "PEDIMENTO.ANIO": {
        "source": "PEDIMENTO.NUMERO_NORMALIZADO",
        "slice": [
          0,
          2
        ]
      },
      "PEDIMENTO.ADUANA_DESPACHO": {
        "source": "PEDIMENTO.NUMERO_NORMALIZADO",
        "slice": [
          2,
          4
        ]
      },
      "PEDIMENTO.PATENTE": {
        "source": "PEDIMENTO.NUMERO_NORMALIZADO",
        "slice": [
          4,
          8
        ]
      },
      "PEDIMENTO.CONSECUTIVO": {
        "source": "PEDIMENTO.NUMERO_NORMALIZADO",
        "slice": [
          8,
          15
        ]
      },
      "PEDIMENTO.TIPO_OPERACION_NORMALIZADO": {
        "source": "PEDIMENTO.TIPO_OPERACION",
        "map": {
          "IMP": "IMPORTACION",
          "EXP": "EXPORTACION"
        },
        "default": "OTRO"
      },
      "INCREMENTABLES.TOTAL": {
        "formula": "INCREMENTABLES.SEGUROS + INCREMENTABLES.FLETES + INCREMENTABLES.EMBALAJES + INCREMENTABLES.OTROS"
      },
      "DECREMENTABLES.TOTAL": {
        "formula": "DECREMENTABLES.TRANSPORTE + DECREMENTABLES.SEGURO + DECREMENTABLES.CARGA + DECREMENTABLES.DESCARGA + DECREMENTABLES.OTROS"
      },
      "LIQUIDACION.TOTAL_CONCEPTOS": {
        "formula": "SUM(LIQUIDACION.CONCEPTOS.IMPORTE)"
      },
      "FACTURAS.TOTAL_DOLARES": {
        "formula": "SUM(FACTURAS.VALOR_DOLARES)"
      },
      "PAIS_ORIGEN_PRINCIPAL": {
        "source": "PARTIDAS.PAIS_ORIGEN_DESTINO",
        "transform": "single_distinct_or_null"
      },
      "RECTIFICACION.ES_RECTIFICACION": {
        "formula": "DOCUMENTO.SUBTIPO == 'RECTIFICACION' OR PEDIMENTO.CLAVE == 'R1'"
      },
      "CONSOLIDACION.ES_CONSOLIDADO": {
        "formula": "DOCUMENTO.SUBTIPO == 'CONSOLIDADO' OR CONSOLIDACION.NUMERO_AVISO != null"
      },
      "PAGO.PRESENTE": {
        "formula": "PAGO.LINEA_CAPTURA != null OR PAGO.IMPORTE_PAGADO != null"
      }
    },
    "validation_rules": [
      {
        "field": "PEDIMENTO.NUMERO_NORMALIZADO",
        "rule_type": "regex",
        "pattern": "^\\d{15}$",
        "message": "El pedimento normalizado debe contener 15 dígitos"
      },
      {
        "field": "IMPORTADOR_EXPORTADOR.RFC",
        "rule_type": "regex",
        "pattern": "^[A-ZÑ&]{3,4}\\d{6}[A-Z0-9]{3}$",
        "skip_if_missing": true,
        "message": "El RFC del importador/exportador tiene formato inválido"
      },
      {
        "field": "VALORES.TIPO_CAMBIO",
        "rule_type": "greater_than",
        "value": 0,
        "skip_if_missing": true,
        "message": "El tipo de cambio debe ser mayor que cero"
      },
      {
        "field": "INCREMENTABLES.TOTAL",
        "rule_type": "custom_formula",
        "formula": "INCREMENTABLES.SEGUROS + INCREMENTABLES.FLETES + INCREMENTABLES.EMBALAJES + INCREMENTABLES.OTROS",
        "tolerance": 0.02,
        "skip_if_missing": true,
        "message": "El total de incrementables no coincide; VALOR_SEGUROS no se suma"
      },
      {
        "field": "DECREMENTABLES.TOTAL",
        "rule_type": "custom_formula",
        "formula": "DECREMENTABLES.TRANSPORTE + DECREMENTABLES.SEGURO + DECREMENTABLES.CARGA + DECREMENTABLES.DESCARGA + DECREMENTABLES.OTROS",
        "tolerance": 0.02,
        "skip_if_missing": true,
        "message": "El total de decrementables no coincide"
      },
      {
        "field": "VALORES.VALOR_ADUANA",
        "rule_type": "custom_formula",
        "formula": "VALORES.VALOR_COMERCIAL_PESOS + INCREMENTABLES.TOTAL - DECREMENTABLES.TOTAL",
        "tolerance": 5,
        "skip_if_missing": true,
        "message": "El valor en aduana no concilia con valor comercial e incrementables/decrementables"
      },
      {
        "field": "LIQUIDACION.TOTALES.TOTAL",
        "rule_type": "sum_array",
        "source": "LIQUIDACION.CONCEPTOS.IMPORTE",
        "tolerance": 1,
        "skip_if_missing": true,
        "message": "El total de liquidación no coincide con sus conceptos"
      },
      {
        "field": "LIQUIDACION.TOTALES.TOTAL",
        "rule_type": "custom_formula",
        "formula": "LIQUIDACION.TOTALES.EFECTIVO + LIQUIDACION.TOTALES.OTROS",
        "tolerance": 1,
        "skip_if_missing": true,
        "message": "El total de liquidación no coincide con efectivo más otros"
      },
      {
        "field": "PAGO.IMPORTE_PAGADO",
        "rule_type": "equals_field",
        "source": "LIQUIDACION.TOTALES.EFECTIVO",
        "tolerance": 1,
        "skip_if_missing": true,
        "message": "El importe pagado debe compararse con el total efectivo"
      },
      {
        "field": "PEDIMENTO.NUMERO_TOTAL_PARTIDAS",
        "rule_type": "array_length",
        "source": "PARTIDAS",
        "skip_if_missing": true,
        "message": "El total impreso de partidas no coincide con las partidas extraídas"
      },
      {
        "field": "VALORES.VALOR_ADUANA",
        "rule_type": "sum_array",
        "source": "PARTIDAS.VALOR_ADUANA_MXN",
        "tolerance": 5,
        "skip_if_missing": true,
        "message": "La suma del valor aduana de partidas no coincide con el encabezado"
      },
      {
        "field": "PEDIMENTO.CLAVE_PREVALIDADOR",
        "rule_type": "regex",
        "pattern": "^\\d{3}$",
        "skip_if_missing": true,
        "message": "La clave del prevalidador debe tener 3 dígitos"
      },
      {
        "field": "PAGO.PATENTE",
        "rule_type": "equals_field",
        "source": "PEDIMENTO.PATENTE",
        "skip_if_missing": true,
        "message": "La patente del pago no coincide con la del pedimento"
      },
      {
        "field": "PAGO.PEDIMENTO",
        "rule_type": "equals_field",
        "source": "PEDIMENTO.CONSECUTIVO",
        "skip_if_missing": true,
        "message": "El consecutivo del pago no coincide con el pedimento"
      }
    ],
