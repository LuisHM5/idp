      "TOTAL_PEDIMENTO",
      "FACTURAS",
      "PARTIDAS"
    ],
    "validation_rules": [
      {
        "field": "NUMERO_PEDIMENTO_NORMALIZADO",
        "rule_type": "regex",
        "pattern": "^\\d{15}$",
        "message": "El número de pedimento normalizado debe contener exactamente 15 dígitos"
      },
      {
        "field": "NUMERO_PEDIMENTO_NORMALIZADO",
        "rule_type": "custom_formula",
        "formula": "ANIO_PEDIMENTO + ADUANA_DESPACHO + PATENTE + NUMERO_CONSECUTIVO",
        "message": "El número normalizado no coincide con los componentes del pedimento"
      },
      {
        "field": "RFC_IMPORTADOR_EXPORTADOR",
        "rule_type": "regex",
        "pattern": "^[A-ZÑ&]{3,4}\\d{6}[A-Z0-9]{3}$",
        "message": "RFC del importador o exportador inválido"
      },
      {
        "field": "TIPO_CAMBIO",
        "rule_type": "greater_than",
        "value": 0,
        "message": "El tipo de cambio debe ser mayor que cero"
      },
      {
        "field": "TOTAL_INCREMENTABLES",
        "rule_type": "custom_formula",
        "formula": "VALOR_SEGUROS + SEGUROS + FLETES + EMBALAJES + OTROS_INCREMENTABLES",
        "tolerance": 0.01,
        "message": "El total de incrementables no coincide con sus conceptos"
      },
      {
        "field": "TOTAL_DECREMENTABLES",
        "rule_type": "custom_formula",
        "formula": "TRANSPORTE_DECREMENTABLE + SEGURO_DECREMENTABLE + CARGA_DECREMENTABLE + DESCARGA_DECREMENTABLE + OTROS_DECREMENTABLES",
        "tolerance": 0.01,
        "message": "El total de decrementables no coincide con sus conceptos"
      },
      {
        "field": "VALOR_ADUANA",
        "rule_type": "custom_formula",
        "formula": "VALOR_COMERCIAL_PESOS + TOTAL_INCREMENTABLES - TOTAL_DECREMENTABLES",
        "tolerance": 5,
        "message": "El valor en aduana no coincide con el valor comercial y sus ajustes"
      },
      {
        "field": "VALOR_COMERCIAL_PESOS",
        "rule_type": "custom_formula",
        "formula": "SUM(FACTURAS.VALOR_DOLARES * TIPO_CAMBIO)",
        "tolerance": 2,
        "message": "El valor comercial no coincide con la suma de las facturas convertidas a pesos"
      },
      {
        "field": "CUADRO_LIQUIDACION.TOTAL",
        "rule_type": "sum_array",
        "source": "CUADRO_LIQUIDACION.CONCEPTOS.IMPORTE",
        "tolerance": 1,
        "message": "El total del cuadro de liquidación no coincide con la suma de sus conceptos"
      },
      {
        "field": "CUADRO_LIQUIDACION.TOTAL",
        "rule_type": "custom_formula",
        "formula": "CUADRO_LIQUIDACION.TOTAL_EFECTIVO + CUADRO_LIQUIDACION.TOTAL_OTROS",
        "tolerance": 1,
        "message": "El total del pedimento no coincide con efectivo más otros"
      },
      {
        "field": "TOTAL_PEDIMENTO",
        "rule_type": "equals_field",
        "source": "CUADRO_LIQUIDACION.TOTAL",
        "tolerance": 1,
        "message": "El total del pedimento no coincide con el cuadro de liquidación"
      },
      {
        "field": "IMPORTE_PAGADO",
        "rule_type": "equals_field",
        "source": "TOTAL_PEDIMENTO",
        "tolerance": 1,
        "message": "El importe pagado no coincide con el total del pedimento"
      },
      {
        "field": "NUMERO_TOTAL_PARTIDAS",
        "rule_type": "array_length",
        "source": "PARTIDAS",
        "message": "El número total de partidas no coincide con las partidas extraídas"
      }
    ],
    "validator_module": "validators.customs.pedimento"
  }
}
