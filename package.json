{
  "name": "documents-validator",
  "version": "1.0.0",
  "description": "Sistema extensible de validacion documental con Amazon Bedrock",
  "maintainers": [
    "lhernandezm"
  ],
  "main": "dist/document-validation-stack.js",
  "scripts": {
    "build": "python3 scripts/validar-mapeos-deterministas.py && node scripts/sync-catalogs.mjs && tsc",
    "catalogs:lint": "python3 scripts/validar-mapeos-deterministas.py",
    "sync": "node scripts/sync-schema.mjs",
    "sync:one": "node scripts/sync-schema.mjs --one",
    "sync:prod": "node scripts/sync-schema.mjs --env prod",
    "sync:one:prod": "node scripts/sync-schema.mjs --one --env prod",
    "setup:python": "python3 -m venv .venv && .venv/bin/pip install -q -r requirements-dev.txt",
    "test:unit": ".venv/bin/pytest tests/unit -q && node --test \"tests/unit/node/*.test.mjs\"",
    "test:quality": ".venv/bin/python scripts/run-quality-tests.py",
    "test:real": ".venv/bin/python scripts/run-real-tests.py",
    "test:pedimentos": ".venv/bin/python scripts/test-pedimentos.py",
    "comparar": "bash scripts/comparar-documento.sh",
    "comparar:formato": ".venv/bin/python scripts/comparar-formato-respuesta.py",
    "test:e2e:pedimento": ".venv/bin/python scripts/test-e2e-pedimento.py",
    "test:e2e:suite": ".venv/bin/python scripts/test-e2e-suite.py",
    "test:e2e:init": ".venv/bin/python scripts/test-e2e-suite.py --init",
    "costos:validar": ".venv/bin/python scripts/costos-validar.py",
    "test:encryption": "pnpm build && node scripts/check-encryption-templates.mjs",
    "test:infra-contract": "node scripts/check-infra-migration.mjs --env dev",
    "schema:sensitivity": ".venv/bin/python scripts/schema-sensitivity.py",
    "procesar": ".venv/bin/python scripts/procesar-docs.py",
    "bench:latencia": ".venv/bin/python scripts/bench-latencia.py",
    "analizar": ".venv/bin/python scripts/analizar-resultados.py",
    "paginas": ".venv/bin/python scripts/analizar-seleccion-paginas.py",
    "autenticidad": ".venv/bin/python scripts/analizar-autenticidad.py",
    "test:autenticidad": ".venv/bin/python scripts/test-autenticidad.py",
    "vision:comparar": ".venv/bin/python scripts/comparar-vision.py",
    "refs:register": ".venv/bin/python scripts/manage-references.py register",
    "refs:list": ".venv/bin/python scripts/manage-references.py list",
    "refs:remove": ".venv/bin/python scripts/manage-references.py remove",
    "refs:reindex": ".venv/bin/python scripts/manage-references.py reindex",
    "refs:search": ".venv/bin/python scripts/manage-references.py search",
    "refs:eval": ".venv/bin/python scripts/evaluar-referencias.py",
    "resultado": ".venv/bin/python scripts/ver-resultado.py",
    "costos": ".venv/bin/python scripts/ver-costos.py",
    "reporte:costos": ".venv/bin/python scripts/reporte-costos.py",
    "reporte:documentos": ".venv/bin/python scripts/reporte-documentos.py",
    "reporte": ".venv/bin/python scripts/reporte.py",
    "migrate:kms": ".venv/bin/python scripts/migrate-s3-encryption.py",
    "migration:plan": ".venv/bin/python scripts/aws_migration.py plan",
    "migration:backup": ".venv/bin/python scripts/aws_migration.py backup",
    "migration:restore": ".venv/bin/python scripts/aws_migration.py restore",
    "migration:deploy": ".venv/bin/python scripts/aws_migration.py deploy",
    "enviar": "bash scripts/enviar-documento.sh",
    "synth": "npx cdk synth",
    "bootstrap:cost-tags": "npm run bootstrap:cost-tags:dev",
    "bootstrap:cost-tags:dev": "node scripts/ensure-bootstrap-cost-tag.mjs --env dev",
    "bootstrap:cost-tags:prod": "node scripts/ensure-bootstrap-cost-tag.mjs --env prod",
    "tag:costs:dev": "node scripts/tag-cost-resources.mjs --env dev",
    "tag:costs:prod": "node scripts/tag-cost-resources.mjs --env prod",
    "prepare:infra:dev": "npm run bootstrap:cost-tags:dev && npm run tag:costs:dev",
    "prepare:infra:prod": "npm run bootstrap:cost-tags:prod && npm run tag:costs:prod",
    "deploy": "npm run deploy:dev",
    "synth:dev": "npx cdk synth DocumentValidationStack-Dev -c env=dev --quiet",
    "synth:prod": "npx cdk synth DocumentValidationStack -c env=prod --quiet",
    "deploy:table": "npm run synth:dev && node scripts/check-pending-tables.mjs --env dev",
    "deploy:fast": "npm run prepare:infra:dev && npm run synth:dev && node scripts/check-infra-migration.mjs --env dev && npx cdk deploy --app cdk.out DocumentValidationStack-Dev --require-approval never",
    "deploy:dev": "npm run build && npm run prepare:infra:dev && npm run synth:dev && node scripts/check-infra-migration.mjs --env dev && node scripts/check-pending-tables.mjs --env dev && npx cdk deploy --app cdk.out DocumentValidationStack-Dev --require-approval never",
    "deploy:prod": "npm run build && npm run prepare:infra:prod && npm run synth:prod && node scripts/check-infra-migration.mjs --env prod && node scripts/check-pending-tables.mjs --env prod && npx cdk deploy --app cdk.out DocumentValidationStack",
    "diff": "npx cdk diff",
    "diff:dev": "npx cdk diff DocumentValidationStack-Dev -c env=dev",
    "diff:prod": "npx cdk diff DocumentValidationStack -c env=prod",
    "import-cert": "node scripts/import-cert.mjs",
    "apps:register": "node scripts/manage-apps.mjs register",
    "apps:rotate": "node scripts/manage-apps.mjs rotate",
    "apps:reconfigure": "node scripts/manage-apps.mjs reconfigure",
    "apps:grant": "node scripts/manage-apps.mjs grant",
    "apps:deny": "node scripts/manage-apps.mjs deny",
    "apps:disable": "node scripts/manage-apps.mjs disable",
    "apps:enable": "node scripts/manage-apps.mjs enable",
    "apps:list": "node scripts/manage-apps.mjs list",
    "apps:usage": "node scripts/manage-apps.mjs usage",
    "apps:revoke": "node scripts/manage-apps.mjs revoke",
    "apps:adopt": "node scripts/manage-apps.mjs adopt",
    "destroy": "npx cdk destroy",
    "destroy:full": "node scripts/destroy-full.mjs",
    "docs:api": "node documentacion/api-docs/serve.mjs",
    "backfill:index": "node scripts/backfill-index.mjs",
    "backfill:keys": "node scripts/backfill-keys.mjs",
    "test-local": "node scripts/test-local.mjs",
    "test-e2e": "node scripts/test-e2e.mjs",
    "test:node": "node --test \"tests/unit/node/*.test.mjs\"",
    "doc:pdf": "bash scripts/doc-a-pdf.sh"
  },
  "keywords": [],
  "author": "Luis Hernández Macías",
  "license": "ISC",
  "packageManager": "pnpm@10.20.0",
  "dependencies": {
    "aws-cdk-lib": "^2.252.0",
    "constructs": "10.6.0"
  },
  "devDependencies": {
    "@types/node": "^25.6.0",
    "ts-node": "^10.9.2"
  }
}
