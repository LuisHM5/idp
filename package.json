{
  "name": "documents-validator",
  "version": "1.0.0",
  "description": "Sistema extensible de validacion documental con Amazon Bedrock",
  "main": "dist/document-validation-stack.js",
  "scripts": {
    "build": "node scripts/sync-catalogs.mjs && node scripts/patch-construct.mjs && tsc",
    "sync": "node scripts/sync-schema.mjs",
    "sync:one": "node scripts/sync-schema.mjs --one",
    "setup:python": "python3 -m venv .venv && .venv/bin/pip install -q -r requirements-dev.txt",
    "test:unit": ".venv/bin/python -m pytest tests/unit -q",
    "test:pedimentos": ".venv/bin/python scripts/test-pedimentos.py",
    "procesar": ".venv/bin/python scripts/procesar-docs.py",
    "resultado": ".venv/bin/python scripts/ver-resultado.py",
    "enviar": "bash scripts/enviar-documento.sh",
    "synth": "npx cdk synth",
    "deploy": "npx cdk deploy --require-approval never",
    "diff": "npx cdk diff",
    "destroy": "npx cdk destroy",
    "destroy:full": "node scripts/destroy-full.mjs",
    "preview-prompts": "node scripts/preview-prompts.mjs",
    "test-local": "node scripts/test-local.mjs",
    "test-e2e": "node scripts/test-e2e.mjs",
    "track": "node scripts/track-execution.mjs"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "packageManager": "pnpm@10.20.0",
  "dependencies": {
    "@cdklabs/cdk-appmod-catalog-blueprints": "^1.17.0",
    "aws-cdk-lib": "^2.252.0",
    "constructs": "10.6.0"
  },
  "devDependencies": {
    "@types/node": "^25.6.0",
    "ts-node": "^10.9.2"
  }
}
